#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.10"
# ///
"""tmux window switcher: windows grouped by project, coloured by pi agent state.

Usage (from tmux.conf; see README.md next to this script):
  bind '"' display-popup -B -E -w 100% -h 100% "~/bin/tmux-switch '#{session_name}'"
Requires fzf and uv; tmux-switch-action must sit in the same directory.

Keys (normal mode, prompt '# '):
  j/k  move     J/K  next/prev project     g/G  top/bottom     C-d/C-u  half page
  l/Enter  switch     q/Esc  quit     C-/  toggle preview
  digits   jump to that window number (switches at once when unambiguous)
  /        search mode (prompt '/ '): type to filter; Esc back to normal mode

Agent state comes from window options @agent_state / @agent_since, which are
set by the tmux-agent-state.ts pi extension (shipped alongside this script).
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass

HOME = os.path.expanduser("~")
SEP = "<|>"
DELETED = " (deleted)"
WORKTREE_RE = re.compile(r"-agent-worktree-(\d+)$")
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")

RESET = "\x1b[0m"
BOLD = "\x1b[1m"
DIM = "\x1b[2m"
RED = "\x1b[31m"
GREEN = "\x1b[32m"
YELLOW = "\x1b[33m"
CYAN = "\x1b[36m"
GREY = "\x1b[90m"


def tmux(*args: str) -> str:
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout


def project_root(path: str) -> str:
    """Repo top level for path, folding pi-side-agents worktrees (<repo>-agent-worktree-N) into <repo>."""
    try:
        top = subprocess.run(
            ["git", "-C", path, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=2,
        ).stdout.strip()
    except Exception:
        top = ""
    top = top or path
    m = WORKTREE_RE.search(top)
    return top[: m.start()] if m else top


def pretty_path(path: str) -> str:
    for base in (HOME + "/projects/", HOME + "/src/"):
        if path.startswith(base):
            return path[len(base):] if base.endswith("/projects/") else "src/" + path[len(base):]
    if path == HOME:
        return "~"
    if path.startswith(HOME + "/"):
        return "~/" + path[len(HOME) + 1:]
    return path


def pi_summary(title: str) -> str:
    """pi sets the terminal title to 'π - <session summary> - <dir>'; extract the summary."""
    if not title.startswith("π - "):
        return ""
    parts = title[len("π - "):].rsplit(" - ", 1)
    return parts[0] if len(parts) == 2 else ""


def age(since: str) -> str:
    try:
        s = max(0, int(time.time()) - int(since))
    except ValueError:
        return ""
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def state_cell(state: str, since: str, bell: bool) -> tuple[str, int]:
    """(coloured cell, rank) — rank used for group summary."""
    a = age(since)
    if state == "working":
        cell = f"{YELLOW}● working {a:>3}{RESET}"
    elif state == "done":
        cell = f"{BOLD}{GREEN}✔ done    {a:>3}{RESET}"
    elif state == "idle":
        cell = f"{DIM}○ idle    {a:>3}{RESET}"
    else:
        cell = f"{GREY}·{' ' * 12}{RESET}"
    if bell and not state:
        cell = f"{RED}! bell{' ' * 7}{RESET}"
    return cell, {"done": 0, "working": 1, "idle": 2}.get(state, 3)


def state_glyph(state: str, since: str) -> str:
    """Uncoloured state cell (same width as state_cell's)."""
    a = age(since)
    label = {"working": "● working", "done": "✔ done   ", "idle": "○ idle   "}.get(state)
    return f"{label} {a:>3}" if label else "·" + " " * 12


def load_registry(root: str) -> dict[str, tuple[str, str]]:
    """pi-side-agents registry of a project: tmux window id -> (agent id, parent agent id)."""
    try:
        with open(os.path.join(root, ".pi", "side-agents", "registry.json")) as f:
            agents = json.load(f).get("agents", {})
    except (OSError, ValueError, AttributeError):
        return {}
    out = {}
    for rec in agents.values() if isinstance(agents, dict) else ():
        if isinstance(rec, dict) and rec.get("tmuxWindowId") and rec.get("id"):
            out[rec["tmuxWindowId"]] = (str(rec["id"]), str(rec.get("parentAgentId") or ""))
    return out


@dataclass
class Win:
    idx: int
    wid: str
    name: str
    active: bool
    cmd: str
    path: str
    state: str
    since: str
    bell: bool
    title: str
    gone: bool
    agent_id: str = ""      # pi-side-agents agent id ("" = not a side agent / unknown)
    parent_agent: str = ""  # agent id of the spawning side agent ("" = spawned by a main session)
    parent_win: str = ""    # tmux window id of the spawning session, when tagged


def tree_order(wins: list[Win], root: str) -> list[tuple[Win, str, int, bool]]:
    """Order a project's windows as a tree: side agents right below the window that spawned them.

    Returns (window, tree prefix, level, orphan) in display order. The parent is the tagged
    spawning window, else the window of the parent agent; windows of agents launched by an older
    pi-side-agents (no tag, spawned by a main session) go under the project's main pi window
    when there is exactly one. Windows without a parent here are roots, in index order.
    """
    by_wid = {w.wid: w for w in wins}
    by_agent = {w.agent_id: w for w in wins if w.agent_id}
    mains = [w for w in wins if w.path == root and not w.agent_id and (w.state or w.cmd == "pi" or w.title.startswith("π"))]
    parent_of: dict[str, Win] = {}
    orphans: set[str] = set()
    for w in wins:
        p = by_wid.get(w.parent_win) if w.parent_win else None
        if p is None and w.parent_agent:
            p = by_agent.get(w.parent_agent)
            if p is None:
                orphans.add(w.wid)
        # untagged, or orphaned (adopted by the main session): under the sole main pi window, if any
        if p is None and (w.wid in orphans or not w.parent_win) and len(mains) == 1:
            if w.agent_id or WORKTREE_RE.search(w.path):
                p = mains[0]
        if p is not None and p is not w:
            parent_of[w.wid] = p
    children: dict[str, list[Win]] = {}
    for w in wins:
        if w.wid in parent_of:
            children.setdefault(parent_of[w.wid].wid, []).append(w)

    out: list[tuple[Win, str, int, bool]] = []
    seen: set[str] = set()

    def walk(w: Win, cont: str, glyph: str, level: int) -> None:
        if w.wid in seen:  # paranoia against parent cycles
            return
        seen.add(w.wid)
        out.append((w, cont + glyph, level, w.wid in orphans))
        kids = children.get(w.wid, [])
        sub = cont + ("" if level == 0 else "  " if glyph == "└ " else "│ ")
        for i, k in enumerate(kids):
            walk(k, sub, "└ " if i == len(kids) - 1 else "├ ", level + 1)

    for w in wins:
        if w.wid not in parent_of:
            walk(w, "", "", 0)
    for w in wins:  # anything left over (parent cycles) still gets listed
        if w.wid not in seen:
            walk(w, "", "", 0)
    return out


def build(session: str) -> tuple[list[str], int, list[tuple[str, int]]]:
    fmt = SEP.join([
        "#{window_index}", "#{window_name}", "#{window_active}", "#{pane_current_command}",
        "#{pane_current_path}", "#{@agent_state}", "#{@agent_since}", "#{window_bell_flag}", "#{pane_title}",
        "#{window_id}", "#{@side_agent_id}", "#{@side_agent_parent}", "#{@side_agent_parent_window}",
    ])
    wins: list[Win] = []
    for l in tmux("list-windows", "-t", session, "-F", fmt).split("\n"):
        r = l.split(SEP)
        if len(r) != 13:
            continue
        idx, name, active, cmd, path, state, since, bell, title, wid, agent_id, parent_agent, parent_win = r
        # tmux appends " (deleted)" when the pane's cwd was removed (e.g. a finished side-agent worktree)
        gone = path.endswith(DELETED)
        if gone:
            path = path[: -len(DELETED)]
        wins.append(Win(int(idx), wid, name, active == "1", cmd, path, state, since, bell == "1", title, gone,
                        agent_id, parent_agent, parent_win))
    paths = sorted({w.path for w in wins})
    with ThreadPoolExecutor(max_workers=16) as ex:
        roots = dict(zip(paths, ex.map(project_root, paths)))
    registries = {root: load_registry(root) for root in set(roots.values())}

    groups: dict[str, list[Win]] = {}
    for w in wins:
        root = roots[w.path]
        if not w.agent_id:  # window not tagged by pi-side-agents (older version): fall back to its registry
            w.agent_id, w.parent_agent = registries[root].get(w.wid, ("", ""))
        groups.setdefault(root, []).append(w)

    def gkey(root: str):
        return (root != HOME, pretty_path(root).lower())

    lines: list[str] = []
    meta: list[tuple[str, int]] = []  # per line: ("h", first window idx) or ("w", window idx)
    cur_pos = 1
    for root in sorted(groups, key=gkey):
        ordered = tree_order(sorted(groups[root], key=lambda w: w.idx), root)
        proj = pretty_path(root)
        # agents spawned by other agents report to their parent agent, not to you: dimmed, not counted
        counts = {s: sum(1 for w, _, level, _ in ordered if w.state == s and level < 2) for s in ("working", "done")}
        summary = "".join([
            f"  {BOLD}{GREEN}✔{counts['done']}{RESET}" if counts["done"] else "",
            f"  {YELLOW}●{counts['working']}{RESET}" if counts["working"] else "",
        ])
        first = ordered[0][0].idx
        lines.append(f"{first}\t{BOLD}{CYAN}{proj}{RESET}{summary}")
        meta.append(("h", first))
        for w, tree, level, orphan in ordered:
            dim = level >= 2
            if dim:
                cell = f"{GREY}{state_glyph(w.state, w.since)}{RESET}"
            else:
                cell, _ = state_cell(w.state, w.since, w.bell)
            label = w.name
            if w.cmd and w.cmd != w.name and w.cmd not in ("bash", "zsh", "sh", "node") and not w.state:
                label += f" {GREY}[{w.cmd}]{RESET}"
            m = WORKTREE_RE.search(w.path)
            if m:
                label += f" {GREY}⎇{int(m.group(1))}{RESET}"
            if w.gone:
                label += f" {RED}(dir gone){RESET}"
            if orphan:
                label += f" {GREY}(parent {w.parent_agent} gone){RESET}"
            if w.path != root and not m:
                label += f" {GREY}{pretty_path(w.path)}{RESET}"
            summary = pi_summary(w.title)
            if summary:
                label += f"  {GREY}{summary}{RESET}"
            if dim:
                label = f"{GREY}{re.sub(ANSI_RE, '', label)}{RESET}"
            mark = f"{BOLD}*{RESET}" if w.active else " "
            lines.append(f"{w.idx}\t  {w.idx:>2}{mark} {cell}  {GREY}{tree}{RESET}{label}  {DIM}{GREY}· {proj}{RESET}")
            meta.append(("w", w.idx))
            if w.active:
                cur_pos = len(lines)
    return lines, cur_pos, meta


def preview(session: str, idx: str) -> None:
    rows = int(os.environ.get("FZF_PREVIEW_LINES", "40"))
    out = tmux("capture-pane", "-e", "-p", "-J", "-t", f"{session}:{idx}").rstrip("\n").split("\n")
    while out and not re.sub(r"\x1b\[[0-9;]*m", "", out[-1]).strip():
        out.pop()
    sys.stdout.write("\n".join(out[-rows:]) + "\n")


def preview_window(n_lines: int) -> str:
    """Give the preview whatever rows the full list leaves free; hide it if that's too little."""
    try:
        rows = os.get_terminal_size(sys.stderr.fileno()).lines
    except OSError:
        rows = 50
    free = rows - n_lines - 3  # prompt line, preview border, slack
    if free >= 10:
        return f"down,{free},border-top"
    return "down,50%,border-top,hidden"


NORMAL_PROMPT = "# "   # normal mode: j/k navigate, digits jump to window number (see tmux-switch-action)
SEARCH_PROMPT = "/ "   # search mode: type to filter
NORMAL_KEYS = "j,k,g,G,l,q,J,K,/"


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] == "--preview":
        preview(args[1], args[2])
        return
    session = args[0] if args and "#{" not in args[0] else tmux("display-message", "-p", "#{session_name}").strip()
    lines, cur_pos, meta = build(session)
    me = os.path.abspath(sys.argv[0])
    q = lambda s: "'" + s.replace("'", "'\\''") + "'"
    helper = os.path.join(os.path.dirname(me), "tmux-switch-action")
    fd, cache = tempfile.mkstemp(prefix="tmux-switch-", suffix=".meta")
    with os.fdopen(fd, "w") as f:
        f.write("".join(f"{k} {i}\n" for k, i in meta))
    act = lambda kind: f"transform({q(helper)} {kind} {q(cache)})"
    try:
        fzf = subprocess.run(
            [
                "fzf", "--ansi", "--no-sort", "--layout=reverse", "--delimiter=\t", "--with-nth=2",
                "--info=inline-right", f"--prompt={NORMAL_PROMPT}", "--pointer=▶", "--gutter= ", "--cycle",
                "--disabled",
                f"--bind=load:pos({cur_pos})",
                "--bind=j:down,k:up,g:first,G:last,l:accept,q:abort,ctrl-d:half-page-down,ctrl-u:half-page-up",
                f"--bind=J:{act('next-group')},K:{act('prev-group')}",
                f"--bind=/:unbind({NORMAL_KEYS})+enable-search+clear-query+change-prompt({SEARCH_PROMPT})",
                f"--bind=esc:{act('esc')}",
                f"--bind=change:{act('digits')}",
                f"--preview={q(helper)} preview {q(session)} {{1}}",
                f"--preview-window={preview_window(len(lines))}", "--bind=ctrl-/:toggle-preview",
            ],
            input="\n".join(lines) + "\n", stdout=subprocess.PIPE, text=True,
        )
    finally:
        os.unlink(cache)
    choice = fzf.stdout.strip()
    if fzf.returncode == 0 and choice:
        tmux("select-window", "-t", f"{session}:{choice.split(chr(9), 1)[0]}")


if __name__ == "__main__":
    main()
